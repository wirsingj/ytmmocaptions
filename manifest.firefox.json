{
  "manifest_version": 3,
  "name": "Dialogue Captions",
  "version": "0.25.92",
  "description": "MMO-style dialogue panel for YouTube subtitles with chunk navigation.",
  "host_permissions": [
    "https://www.youtube.com/watch*"
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dialogue-captions@wirsingj.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "scripts/platform.js",
        "scripts/page-context.js",
        "scripts/settings-store.js",
        "scripts/caption-text.js",
        "scripts/chunker.js",
        "scripts/bubble-state.js",
        "scripts/transcript.js",
        "scripts/ui-panel.js",
        "scripts/content-script.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
