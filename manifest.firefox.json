{
  "manifest_version": 3,
  "name": "YTMMOCC",
  "version": "1.1.3",
  "description": "MMO-style dialogue panel for YouTube captions and transcripts.",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dialogue-captions@wirsingj.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "scripts/platform.js",
        "scripts/diagnostics.js",
        "scripts/page-context.js",
        "scripts/settings-store.js",
        "scripts/caption-text.js",
        "scripts/chunker.js",
        "scripts/bubble-state.js",
        "scripts/timeline-scrub.js",
        "scripts/transcript.js",
        "scripts/caption-timeline.js",
        "scripts/ui-panel.js",
        "scripts/content-script.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  }
}
