{
  "manifest_version": 3,
  "name": "Dialogue Captions",
  "version": "1.0.5",
  "description": "MMO-style dialogue panel for YouTube subtitles with chunk navigation.",
  "host_permissions": [
    "https://www.youtube.com/watch*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "scripts/platform.js",
        "scripts/page-context.js",
        "scripts/settings-store.js",
        "scripts/caption-text.js",
        "scripts/chunker.js",
        "scripts/bubble-state.js",
        "scripts/transcript.js",
        "scripts/ui-panel.js",
        "scripts/content-script.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  }
}
