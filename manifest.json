{
  "manifest_version": 3,
  "name": "Dialogue Captions",
  "version": "0.25.51",
  "description": "MMO-style dialogue panel for YouTube subtitles with chunk navigation.",
  "host_permissions": [
    "https://www.youtube.com/watch*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/platform.js",
        "src/page-context.js",
        "src/settings-store.js",
        "src/feature-flags.js",
        "src/chunker.js",
        "src/transcript.js",
        "src/ui-panel.js",
        "src/content-script.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
