{
  "manifest_version": 3,
  "name": "Dialogue Captions",
  "version": "1.1.2",
  "description": "MMO-style dialogue panel for existing captions on YouTube and HTML5 videos.",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/platform.js",
        "src/diagnostics.js",
        "src/page-context.js",
        "src/settings-store.js",
        "src/caption-text.js",
        "src/chunker.js",
        "src/bubble-state.js",
        "src/timeline-scrub.js",
        "src/transcript.js",
        "src/caption-timeline.js",
        "src/ui-panel.js",
        "src/universal-captions.js",
        "src/content-script.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://addons.mozilla.org/*",
        "*://chrome.google.com/*",
        "*://chromewebstore.google.com/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  }
}
